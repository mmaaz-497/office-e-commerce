{
  "name": "tokoshopee",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:raw": "next dev",
    "dev:turbo": "tsx scripts/dev.ts --turbo",
    "prebuild": "npm run check:constitution && npm run check:messages && npm run check:media",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:constitution": "tsx scripts/check-constitution.ts",
    "check:media": "tsx scripts/check-media.ts",
    "check:messages": "tsx scripts/check-messages.ts",
    "hash-password": "tsx scripts/hash-password.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "vitest run --project concurrency",
    "verify": "npm run typecheck && npm run lint && npm run check:constitution && npm run check:messages && npm run check:media && npm run test",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed:production": "tsx prisma/seed.production.ts",
    "seed:dev": "tsx prisma/seed.dev.ts",
    "catalogue:import": "tsx scripts/catalogue-import.ts",
    "seed:samples": "tsx prisma/seed.samples.ts",
    "cleanup:samples": "tsx prisma/cleanup.samples.ts"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next": "15.5.25",
    "next-intl": "^4.14.5",
    "zod": "^4.6.5",
    "bcrypt": "^6.0.0",
    "@prisma/client": "^6.19.3",
    "midtrans-client": "^1.4.3"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bcrypt": "^6.0.0",
    "@types/midtrans-client": "^1.4.0",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "@eslint/eslintrc": "^3",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "vitest": "^5.0.1",
    "tsx": "^4.23.13",
    "prisma": "^6.19.3",
    "dotenv": "^18.0.1"
  }
}
