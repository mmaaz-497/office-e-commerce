# Copy this file to .env and fill in real values. Never commit .env.
# See specs/001-tokoshopee-storefront/quickstart.md for the full explanation of each variable.

# PostgreSQL connection (localhost-only in every environment — never a public host/port).
DATABASE_URL="postgresql://tokoshopee:tokoshopee_dev@127.0.0.1:5432/tokoshopee"

# Canonical origin for URLs, sitemap.xml, robots.txt and hreflang tags.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Defaults to "false" (blocks all crawling) when unset, so a staging deployment
# that forgets to set this stays out of search results. Set to "true" only on
# the production deployment — see docs/release-checklist.md.
NEXT_PUBLIC_ALLOW_INDEXING="false"

# Midtrans Snap. Use Sandbox keys in every environment except production
# (Constitution: Technology & Deployment Constraints). MIDTRANS_SERVER_KEY creates
# Snap tokens and verifies webhook signatures; MIDTRANS_CLIENT_KEY is the Snap.js
# front-end key.
MIDTRANS_SERVER_KEY="SB-Mid-server-REPLACE_ME"
MIDTRANS_CLIENT_KEY="SB-Mid-client-REPLACE_ME"
MIDTRANS_IS_PRODUCTION="false"

# Single-operator admin login. ADMIN_PASSWORD_HASH is a bcrypt/argon2 hash, never a
# plaintext password — generate it with: pnpm tsx scripts/hash-password.ts 'your-password'
ADMIN_USERNAME="owner"
ADMIN_PASSWORD_HASH="REPLACE_ME"

# HMAC key for the admin session cookie. Rotating this value logs the owner out of
# every existing session.
SESSION_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# Bearer token the expiry job route requires on every request.
JOB_SECRET="REPLACE_ME_WITH_A_LONG_RANDOM_STRING"

# Uploaded product images (admin → Products). MUST be an absolute path outside the
# release directory, so a deploy never overwrites or deletes it; deploy/deploy.sh
# creates it and deploy/backup.sh copies it off-server nightly.
# See specs/004-catalogue-admin/contracts/deploy.md.
UPLOAD_DIR="/var/lib/tokoshopee/uploads"
# Windows dev example:
# UPLOAD_DIR="E:/tokoshopee-uploads"
